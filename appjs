// 1. CURRENCY SWITCHER
function initCurrencySwitcher() {
  const switchers = document.querySelectorAll('.currency-selector');
  switchers.forEach(select => {
    select.value = currentCurrency;
    select.addEventListener('change', (e) => {
      currentCurrency = e.target.value;
      // Sync other dropdowns if any
      switchers.forEach(s => s.value = currentCurrency);
      
      // Update UI elements
      updateAllPrices();
    });
  });
}

function updateAllPrices() {
  // Update calculator
  updateCalculatorDisplay();
  // Update services table if present
  renderServicesTable();
  // Update affiliate calculator
  updateAffiliateCalculator();
  
  // Custom toast notification
  showToast(`Currency changed to ${currentCurrency}`);
}

