    const minLbl = document.getElementById('lbl-min-qty');
    const maxLbl = document.getElementById('lbl-max-qty');
    if (minLbl) minLbl.textContent = `Min: ${selectedServiceObj.min.toLocaleString()}`;
    if (maxLbl) maxLbl.textContent = `Max: ${selectedServiceObj.max.toLocaleString()}`;
