function initCalculatorWidget() {
  const tabs = document.querySelectorAll('.platform-tab');
  const serviceSelect = document.getElementById('calc-service-select');
  const quantitySlider = document.getElementById('calc-quantity-slider');
  const quantityInput = document.getElementById('calc-quantity-input');
  const linkInput = document.getElementById('calc-link-input');
  const quickOrderBtn = document.getElementById('btn-calc-order');

  if (!serviceSelect || !quantitySlider) return;

  // Tab click handler
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      selectedPlatform = tab.getAttribute('data-platform');
      populateServiceDropdown(selectedPlatform);
    });
  });

  // Populate services for platform
  function populateServiceDropdown(platform) {
    const filtered = SERVICES_DATA.filter(s => s.platform === platform);
    serviceSelect.innerHTML = '';
    filtered.forEach((srv, index) => {
      const option = document.createElement('option');
      option.value = srv.id;
      option.textContent = `${srv.name} — ${formatPrice(srv.priceUSD)} / 1K`;
      serviceSelect.appendChild(option);
      if (index === 0) selectedServiceObj = srv;
    });
    updateSliderLimits();
    updateCalculatorDisplay();
  }

  // When service dropdown changes
  serviceSelect.addEventListener('change', () => {
    const id = parseInt(serviceSelect.value);
    selectedServiceObj = SERVICES_DATA.find(s => s.id === id);
    updateSliderLimits();
    updateCalculatorDisplay();
  });

  function updateSliderLimits() {
    if (!selectedServiceObj) return;
    quantitySlider.min = selectedServiceObj.min;
    quantitySlider.max = selectedServiceObj.max;
    // Default to a sensible starting amount
    const defaultVal = Math.min(Math.max(selectedServiceObj.min * 5, 1000), selectedServiceObj.max);
    quantitySlider.value = defaultVal;
    if (quantityInput) quantityInput.value = defaultVal;
    
