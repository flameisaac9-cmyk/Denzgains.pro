let currentCurrency = 'KES'; // Default KES for Kenya

// Global Currency Formatter
function formatPrice(amountUSD, currency = currentCurrency) {
  const symbol = EXCHANGE_RATES[currency].symbol;
  const rate = EXCHANGE_RATES[currency].rate;
  const val = amountUSD * rate;
  
  if (currency === 'KES') {
    return `${symbol}${val.toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }
  return `${symbol}${val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}

